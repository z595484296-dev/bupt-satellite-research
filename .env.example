# Optional local configuration. Empty values retain application defaults.
# Copy to .env locally; never commit .env or real credentials.
HOST=
PORT=
DATA_DIR=
RUNTIME_DIR=
ADMIN_PASSWORD=
COOKIE_SECURE=
TRUST_LOOPBACK_PROXY=

# FlowUs: configure either CLI authorization or a V2 token, on the server only.
FLOWUS_AUTH_MODE=
FLOWUS_CLI_PATH=
FLOWUS_CONFIG_DIR=
FLOWUS_WORKSPACE_ID=
FLOWUS_TOKEN=

# Existing Sites access is supplied separately by the project owner.
SITES_MIRROR_URL=
SITES_ACCESS_TOKEN=
SITES_SYNC_TOKEN=

# Leave empty for the complete local Node site; true only for a mirror build.
VITE_SITES_MIRROR=
